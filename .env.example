# MIRASHOT — Beispiel-Konfiguration (nach .env kopieren; .env ist im Git ignoriert)
# KI-Features (OpenAI-kompatible Vision-Schnittstelle). Ohne diese Variablen
# bleibt die KI deaktiviert — die App funktioniert trotzdem vollständig.
AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AI_API_KEY=<Z.ai-Coding-Plan-Key>
AI_PROTOCOL=openai
AI_MODEL=glm-4.5v

# Server
PORT=3119
SHOT_MAX_PARALLEL=3
SHOT_QUEUE_LIMIT=12
SHOT_TIMEOUT_MS=20000
